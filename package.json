{
  "name": "intrem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "runner": "tsx src/runtime/main.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/main.js",
    "start:runner": "node dist/runtime/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/browser-smoke.mjs",
    "setup": "tsx src/server/setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.269",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "10.1.3",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "4.1.11"
  }
}
